// --- Настройки ---
const CONFIG = {
  promoCode: "FAIRY20",
  ticketLink: "https://example.com/tickets",
  showSettings: false // Установите true, чтобы показать панель настроек
};

// --- Состояние игры ---
let gameState = {
  currentStage: 'quiz', // quiz, memory, chest, final
  quizScore: 0,
  memoryMoves: 0,
  chestScore: 0,
  winner: null,
  memoryCards: [],
  flippedCards: [],
  matchedPairs: 0,
  chestQuestionIndex: 0,
  chestQuestions: []
};

// --- Инициализация ---
document.addEventListener('DOMContentLoaded', () => {
  initSettings();
  
  const startBtn = document.getElementById('start-quest-btn');
  if (startBtn) {
    startBtn.addEventListener('click', startQuiz);
  } else {
    console.error('Start button not found!');
  }
});

// --- Настройки ---
function initSettings() {
  const settingsPanel = document.getElementById('settings-panel');
  const promoInput = document.getElementById('promo-input');
  const linkInput = document.getElementById('link-input');
  const saveBtn = document.getElementById('save-settings');

  if (CONFIG.showSettings) {
    settingsPanel.style.display = 'block';
  }

  // Загрузка сохраненных настроек (если есть)
  const savedPromo = localStorage.getItem('promoCode');
  const savedLink = localStorage.getItem('ticketLink');

  if (savedPromo) CONFIG.promoCode = savedPromo;
  if (savedLink) CONFIG.ticketLink = savedLink;

  promoInput.value = CONFIG.promoCode;
  linkInput.value = CONFIG.ticketLink;

  saveBtn.addEventListener('click', () => {
    CONFIG.promoCode = promoInput.value;
    CONFIG.ticketLink = linkInput.value;
    localStorage.setItem('promoCode', CONFIG.promoCode);
    localStorage.setItem('ticketLink', CONFIG.ticketLink);
    alert('Настройки сохранены!');
  });
}

// --- Переключение экранов ---
function showScreen(screenId) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(screenId).classList.add('active');
}

// --- Игра 1: Викторина (Турнир - King of the Hill) ---
let quizStep = 0;
const TOTAL_QUIZ_STEPS = 20;
let leftCharacter = null;
let rightCharacter = null;
let seenCharacters = []; // ID персонажей, которых мы уже видели

function startQuiz() {
  showScreen('quiz-screen');
  quizStep = 1;
  seenCharacters = [];
  
  // Инициализация первых двух соперников
  const shuffled = [...characters].sort(() => 0.5 - Math.random());
  leftCharacter = shuffled[0];
  rightCharacter = shuffled[1];
  
  // Добавляем их в список просмотренных
  seenCharacters.push(leftCharacter.id);
  seenCharacters.push(rightCharacter.id);
  
  renderQuizStep();
}

function renderQuizStep() {
  const container = document.getElementById('quiz-container');
  container.innerHTML = '';

  // Прогресс бар
  const progressContainer = document.createElement('div');
  progressContainer.className = 'progress-container';
  const progressBar = document.createElement('div');
  progressBar.className = 'progress-bar';
  progressBar.style.width = `${(quizStep / TOTAL_QUIZ_STEPS) * 100}%`;
  progressContainer.appendChild(progressBar);
  container.appendChild(progressContainer);

  // Заголовок
  const stepTitle = document.createElement('h2');
  stepTitle.className = 'quiz-title';
  stepTitle.textContent = `Кого выберешь ты? (${quizStep}/${TOTAL_QUIZ_STEPS})`;
  container.appendChild(stepTitle);

  // Контейнер для дуэли
  const duelContainer = document.createElement('div');
  duelContainer.className = 'duel-container';

  // Левая карточка
  const leftCard = createCharacterCard(leftCharacter, 'left');
  leftCard.onclick = () => handleChoice(leftCharacter);
  
  // VS бейдж
  const vsBadge = document.createElement('div');
  vsBadge.className = 'vs-badge';
  vsBadge.textContent = 'VS';

  // Правая карточка
  const rightCard = createCharacterCard(rightCharacter, 'right');
  rightCard.onclick = () => handleChoice(rightCharacter);

  duelContainer.appendChild(leftCard);
  duelContainer.appendChild(vsBadge);
  duelContainer.appendChild(rightCard);

  container.appendChild(duelContainer);
}

function handleChoice(winner) {
  if (quizStep >= TOTAL_QUIZ_STEPS) {
    showQuizResult(winner);
    return;
  }

  // Определяем, кто проиграл и кто новый претендент
  let nextChallenger = getNextChallenger(winner.id);
  seenCharacters.push(nextChallenger.id);

  // Победитель остается на своем месте, проигравший заменяется
  if (winner.id === leftCharacter.id) {
    // Победил левый -> правый меняется
    animateChange('right', nextChallenger);
  } else {
    // Победил правый -> левый меняется
    animateChange('left', nextChallenger);
  }

  quizStep++;
}

function animateChange(sideToChange, newCharacter) {
  const cardToChange = document.querySelector(`.${sideToChange}-card`);
  
  // Анимация ухода старой карточки
  cardToChange.classList.add('fade-out-card');
  
  setTimeout(() => {
    // Обновляем данные
    if (sideToChange === 'left') {
      leftCharacter = newCharacter;
    } else {
      rightCharacter = newCharacter;
    }
    renderQuizStep();
  }, 300);
}

function getNextChallenger(currentWinnerId) {
  // Фильтруем тех, кто не текущий победитель и кого еще не видели
  let available = characters.filter(c => c.id !== currentWinnerId && !seenCharacters.includes(c.id));
  
  // Если все персонажи уже были показаны, сбрасываем список "виденных" (кроме текущих)
  if (available.length === 0) {
    seenCharacters = [currentWinnerId]; 
    available = characters.filter(c => c.id !== currentWinnerId);
  }
  
  const randomIndex = Math.floor(Math.random() * available.length);
  return available[randomIndex];
}

function createCharacterCard(char, side) {
  const card = document.createElement('div');
  card.className = `character-card ${side}-card`;
  
  const imgContainer = document.createElement('div');
  imgContainer.className = 'card-img-container';
  
  const img = document.createElement('img');
  img.src = char.image;
  img.alt = char.name;
  
  imgContainer.appendChild(img);
  
  const name = document.createElement('div');
  name.className = 'character-name';
  name.textContent = char.name;
  
  card.appendChild(imgContainer);
  card.appendChild(name);
  
  return card;
}

function showQuizResult(winner) {
  gameState.winner = winner;

  const container = document.getElementById('quiz-container');
  container.innerHTML = `
    <div class="quiz-result-card fade-in">
      <h2 class="result-title">Твой герой определён!</h2>

      <div class="winner-circle">
        <img src="${winner.image}" alt="${winner.name}">
      </div>

      <h3 class="winner-name">${winner.name}</h3>
      <p class="winner-desc">Но это ещё не конец! Чтобы получить награду, пройди испытания сказочного мира.</p>

      <button class="btn btn-lg" onclick="startMemoryGame()">
        Следующее испытание ✦
      </button>
    </div>
  `;
}

// --- Утилиты ---
function showModal(title, message, onOk) {
  const modal = document.getElementById('game-modal');
  const titleEl = document.getElementById('modal-title');
  const msgEl = document.getElementById('modal-message');
  const btn = document.getElementById('modal-btn');
  
  titleEl.textContent = title;
  msgEl.textContent = message;
  
  modal.classList.add('active');
  
  // Удаляем старые обработчики
  const newBtn = btn.cloneNode(true);
  btn.parentNode.replaceChild(newBtn, btn);
  
  newBtn.addEventListener('click', () => {
    modal.classList.remove('active');
    if (onOk) onOk();
  });
}

// --- Игра 2: Мемо ---
function startMemoryGame() {
  showScreen('memory-screen');
  gameState.currentStage = 'memory';
  gameState.memoryMoves = 25; // Начинаем с 25 ходов
  gameState.matchedPairs = 0;
  gameState.flippedCards = [];
  
  updateMovesDisplay();

  // Выбираем 8 случайных персонажей
  const gameChars = characters.sort(() => 0.5 - Math.random()).slice(0, 8);
  // Дублируем их для пар
  const cards = [...gameChars, ...gameChars]
    .map((char, index) => ({ ...char, uniqueId: index, isFlipped: false, isMatched: false }))
    .sort(() => 0.5 - Math.random());
  
  gameState.memoryCards = cards;
  renderMemoryGrid();
}

function renderMemoryGrid() {
  const grid = document.getElementById('memory-grid');
  grid.innerHTML = '';
  
  gameState.memoryCards.forEach(card => {
    const cardEl = document.createElement('div');
    cardEl.className = `memory-card ${card.isFlipped ? 'flipped' : ''} ${card.isMatched ? 'matched' : ''}`;
    cardEl.dataset.id = card.uniqueId;
    
    cardEl.innerHTML = `
      <div class="memory-card-inner">
        <div class="memory-card-front"></div>
        <div class="memory-card-back">
          <img src="${card.image}" alt="${card.name}">
          <div class="match-overlay">✦</div>
        </div>
      </div>
    `;
    
    cardEl.onclick = () => handleCardClick(card.uniqueId);
    grid.appendChild(cardEl);
  });
}

function handleCardClick(id) {
  const card = gameState.memoryCards.find(c => c.uniqueId === id);
  
  if (card.isFlipped || card.isMatched || gameState.flippedCards.length >= 2) return;
  
  card.isFlipped = true;
  gameState.flippedCards.push(card);
  renderMemoryGrid(); // Обновляем UI
  
  if (gameState.flippedCards.length === 2) {
    gameState.memoryMoves--; // Уменьшаем количество ходов
    updateMovesDisplay();
    
    if (gameState.memoryMoves < 0) {
      setTimeout(() => {
        showModal('Увы!', 'Ходы закончились! Попробуйте еще раз.', () => startMemoryGame());
      }, 500);
      return;
    }
    
    checkForMatch();
  }
}

function updateMovesDisplay() {
  document.getElementById('moves-count').textContent = gameState.memoryMoves;
}

function checkForMatch() {
  const [card1, card2] = gameState.flippedCards;
  
  if (card1.id === card2.id) {
    // Совпадение
    card1.isMatched = true;
    card2.isMatched = true;
    gameState.matchedPairs++;
    gameState.flippedCards = [];
    renderMemoryGrid();
    
    if (gameState.matchedPairs === 8) {
      setTimeout(() => {
        showModal('Победа!', 'Вы отлично справились! Переходим к следующему этапу.', () => startChestGame());
      }, 500);
    }
  } else {
    // Не совпадение
    setTimeout(() => {
      card1.isFlipped = false;
      card2.isFlipped = false;
      gameState.flippedCards = [];
      renderMemoryGrid();
    }, 1000);
  }
}

// --- Игра 3: Сундук ---
const CHEST_QUESTIONS_COUNT = 10;
const CHEST_WIN_THRESHOLD = 8;

function startChestGame() {
  showScreen('chest-screen');
  gameState.currentStage = 'chest';
  gameState.chestScore = 0;
  gameState.chestQuestionIndex = 0;
  
  // Выбираем 10 случайных вопросов из пула
  const selectedQuestions = chestQuestions
    .sort(() => 0.5 - Math.random())
    .slice(0, CHEST_QUESTIONS_COUNT);
  
  // Подготовка вопросов с рандомизацией ответов
  gameState.chestQuestions = selectedQuestions.map(q => {
    // Берем правильного персонажа
    const correctChar = characters.find(c => c.id === q.correctCharacterId);
    
    // Берем 2 случайных неправильных персонажа
    const otherChars = characters
      .filter(c => c.id !== q.correctCharacterId)
      .sort(() => 0.5 - Math.random())
      .slice(0, 2);
      
    // Собираем опции и перемешиваем их
    const options = [correctChar, ...otherChars].sort(() => 0.5 - Math.random());
    
    return {
      ...q,
      options
    };
  });
  
  renderChestQuestion();
}

function renderChestQuestion() {
  const container = document.getElementById('chest-container');
  container.innerHTML = '';
  
  if (gameState.chestQuestionIndex >= gameState.chestQuestions.length) {
    checkChestResult();
    return;
  }
  
  const question = gameState.chestQuestions[gameState.chestQuestionIndex];
  
  const title = document.createElement('h2');
  title.textContent = `Чей это предмет? (${gameState.chestQuestionIndex + 1}/${gameState.chestQuestions.length})`;
  container.appendChild(title);
  
  const itemDiv = document.createElement('div');
  itemDiv.className = 'chest-item';
  itemDiv.innerHTML = `<img src="${question.itemImage}" alt="${question.itemName}">`;
  container.appendChild(itemDiv);
  
  const itemName = document.createElement('h3');
  itemName.textContent = question.itemName;
  container.appendChild(itemName);
  
  const grid = document.createElement('div');
  grid.className = 'options-grid';
  
  question.options.forEach(char => {
    const card = document.createElement('div');
    card.className = 'option-card';
    card.innerHTML = `
      <img src="${char.image}" alt="${char.name}">
      <div class="name-overlay">${char.name}</div>
      <div class="result-overlay">
        <div class="result-icon"></div>
      </div>
    `;
    
    card.onclick = (e) => handleChestAnswer(char.id, question.correctCharacterId, e.currentTarget);
    grid.appendChild(card);
  });
  
  container.appendChild(grid);
}

function handleChestAnswer(selectedId, correctId, cardElement) {
  // Блокируем повторные клики
  const allCards = document.querySelectorAll('.option-card');
  allCards.forEach(c => c.style.pointerEvents = 'none');
  
  const isCorrect = selectedId === correctId;
  
  if (isCorrect) {
    cardElement.classList.add('correct');
    cardElement.querySelector('.result-icon').textContent = '✓';
    gameState.chestScore++;
  } else {
    cardElement.classList.add('wrong');
    cardElement.querySelector('.result-icon').textContent = '✗';
  }
  
  setTimeout(() => {
    gameState.chestQuestionIndex++;
    renderChestQuestion();
  }, 1500);
}

// --- Финал ---
function finishGame() {
  showScreen('final-screen');
  const container = document.getElementById('final-container');
  container.innerHTML = '';
  
  const winner = gameState.winner || characters[0]; // Fallback
  
  // Создаем красивую структуру
  const wrapper = document.createElement('div');
  wrapper.className = 'final-wrapper';
  
  // Левая колонка: Карточка победителя
  const cardSection = document.createElement('div');
  cardSection.className = 'final-card-section';
  
  const card = document.createElement('div');
  card.className = 'winner-card';
  card.innerHTML = `
    <div class="winner-image-container">
      <img src="${winner.image}" alt="${winner.name}" class="winner-image">
    </div>
    <h2 class="winner-title">${winner.name}</h2>
    <p class="winner-tagline">${winner.tagline}</p>
    <div class="winner-details">
      <p><strong>Сказка:</strong> ${winner.story}</p>
      <p>${winner.description || ''}</p>
    </div>
  `;
  cardSection.appendChild(card);
  
  // Правая колонка: Поздравление и награда
  const rewardSection = document.createElement('div');
  rewardSection.className = 'final-reward-section';
  
  rewardSection.innerHTML = `
    <h1 class="final-title">Поздравляем!</h1>
    <p class="final-subtitle">Ты успешно прошел все испытания!</p>
    <p class="final-text">Твой истинный сказочный герой найден.</p>
    
    <div class="promo-scroll">
      <h3>Волшебный свиток</h3>
      <p>Твоя награда за смелость:</p>
      <div class="promo-code">${CONFIG.promoCode}</div>
      <p class="promo-hint">Предъяви этот код при покупке билета</p>
      <a href="${CONFIG.ticketLink}" target="_blank" class="btn btn-primary btn-lg">Забрать награду</a>
    </div>
    
    <div class="final-actions">
      <button class="btn btn-secondary btn-lg" onclick="shareResult('${winner.name}')">
        Поделиться с другом 📤
      </button>
      <button class="btn btn-outline" onclick="location.reload()">Начать заново 🔄</button>
    </div>
  `;
  
  wrapper.appendChild(cardSection);
  wrapper.appendChild(rewardSection);
  container.appendChild(wrapper);
}

function shareResult(winnerName) {
  const text = `Я прошел сказочный квест и мой герой — ${winnerName}! 🧚‍♂️✨\nУзнай, кто ты из мира сказок: ${window.location.href}`;
  
  if (navigator.share) {
    navigator.share({
      title: 'Мой любимый сказочный герой',
      text: text,
      url: window.location.href,
    }).catch(console.error);
  } else {
    // Fallback for desktop
    navigator.clipboard.writeText(text).then(() => {
      showModal('Ссылка скопирована!', 'Отправь её другу в любом мессенджере.');
    }).catch(() => {
      showModal('Поделиться', 'Скопируй ссылку: ' + window.location.href);
    });
  }
}

function checkChestResult() {
  if (gameState.chestScore >= CHEST_WIN_THRESHOLD) {
    showModal('Поздравляем!', `Вы ответили правильно на ${gameState.chestScore} из ${CHEST_QUESTIONS_COUNT} вопросов!`, () => finishGame());
  } else {
    showModal('Почти получилось!', `Вы набрали ${gameState.chestScore} из ${CHEST_QUESTIONS_COUNT}. Нужно минимум ${CHEST_WIN_THRESHOLD}. Попробуйте еще раз!`, () => startChestGame());
  }
}
